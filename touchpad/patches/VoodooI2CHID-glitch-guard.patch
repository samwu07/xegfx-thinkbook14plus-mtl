+bool VoodooI2CHIDDevice::glitchSimilar(const UInt8* a, const UInt8* b) {
+    for (int f = 0; f < 5; f++) {
+        const UInt8* qa = a + 3 + f * 7;
+        const UInt8* qb = b + 3 + f * 7;
+        if (!((qa[0] >> 1) & 1)) continue;
+        if (!((qb[0] >> 1) & 1) || (qa[0] >> 4) != (qb[0] >> 4)) return false;
+        UInt16 xa = qa[1] | (qa[2] << 8), ya = qa[3] | (qa[4] << 8), xb = qb[1] | (qb[2] << 8), yb = qb[3] | (qb[4] << 8);
