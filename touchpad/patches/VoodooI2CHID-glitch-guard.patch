+    for (int f = 0; f < 5; f++) {
+        const UInt8* q = r + 3 + f * 7;
+        if (!((q[0] >> 1) & 1)) continue;
+        int id = q[0] >> 4;
+        any = true;
+        gl_seen[id] = true; gl_x[id] = q[1] | (q[2] << 8); gl_y[id] = q[3] | (q[4] << 8);
