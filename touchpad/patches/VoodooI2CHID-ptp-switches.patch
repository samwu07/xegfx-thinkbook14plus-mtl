+    // Selective reporting: Windows' touchpad-off shortcut writes 0 to the Surface Switch and Button Switch and the pad keeps
+    // that across a warm reboot, so macOS saw a dead pad. Turn both back on (same write as the input mode). Log once when
+    // one was found off, so a Windows toggle shows up in the log.
+    IOHIDElement *switches[2] = { digitiser.surface_switch, digitiser.button_switch };
