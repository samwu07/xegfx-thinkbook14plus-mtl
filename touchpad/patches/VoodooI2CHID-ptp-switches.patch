+            said[i] = true;
+            IOLog("%s::%s Precision Touchpad %s switch found, value %u: setting it to 1\n", getName(), name,
+                  i ? "Button" : "Surface", (unsigned)switches[i]->getValue(kIOHIDValueOptionsUpdateElementValues));
+        }
+        UInt8 on[] = { 1 };
+        OSData *sw = OSData::withBytes(on, sizeof(on));
+        if (sw) {
+            switches[i]->setDataValue(sw);
