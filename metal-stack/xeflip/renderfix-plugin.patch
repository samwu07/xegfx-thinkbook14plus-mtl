@@ -840,6 +840,31 @@
     const BOOL brec = !noRecycle && _nbpk && nvmtl_bpark_take(self, bkey, &t->_i) == 0;
     if (!brec && nvmtl_vk_image_create_buffer_alias((uint32_t)w, (uint32_t)h, vkf, bpp, a8, (d.usage & MTLTextureUsageShaderWrite) != 0,
                                            (d.usage & MTLTextureUsageRenderTarget) != 0, &_b, offset, bpr, &t->_i)) {
+        const size_t cdxCPUCapacity = _hostPtr && _hostLen < _b.size ? _hostLen : _b.size;
+        // CDX read-only compatibility view: preserve the hardware pitch requirement,
+        // repack rows into a private aligned backing, and resync on every submission.
+        // Only the exact observed BGRA8 single-level, CPU-visible shader-read case.
+        if (d.pixelFormat == MTLPixelFormatBGRA8Unorm && d.usage == MTLTextureUsageShaderRead
+            && bpr && (bpr % 32) && bpr >= w * 4 && offset <= cdxCPUCapacity
+            && h - 1 <= (SIZE_MAX - w * 4) / bpr
+            && bpr * (h - 1) + w * 4 <= cdxCPUCapacity - offset && [self contents]
+            && bpr <= SIZE_MAX - 255) {
+            const size_t pitch = (bpr + 255) & ~(size_t)255;
+            if (h <= SIZE_MAX / pitch) {
+                NVMTLBuffer *sb = [NVMTLBuffer new];
+                if (sb && !nvmtl_vk_buffer_create(pitch * h, 1, &sb->_b) && sb->_b.map) {
+                    sb->_storage = MTLStorageModeShared;
+                    sb->_rowSource = self; sb->_rowSourceOff = offset;
+                    sb->_hostPtr = (char *)[self contents] + offset;
+                    sb->_hostLen = bpr * (h - 1) + w * 4;
+                    sb->_rowHostPitch = bpr; sb->_rowGPUPitch = pitch;
+                    sb->_rowBytes = w * 4; sb->_rowCount = h;
+                    memset(sb->_b.map, 0, pitch * h); nvmtl_buffer_sync_in(sb);
+                    id<MTLTexture> v = [sb newTextureWithDescriptor:d offset:0 bytesPerRow:pitch];
+                    if (v) { static unsigned said; if (said++ < 8) nvlog("CDX pitched readonly view: %zux%zu row %lu -> %zu, resync every submission", w, h, (unsigned long)bpr, pitch); return v; }
+                }
+            }
+        }
         // <wtl> WindowServer's Terminal strips and iconservicesagent's icons ask for views that run past the end of their
         // buffer (mostly NoCopy, so no spare page): give those a stand-in sized to the view, refilled from the caller's bytes
         // at every submission it is used in (and copied back when written)
