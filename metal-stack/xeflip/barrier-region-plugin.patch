  * clears the write-masked bits, and writes colour and depth as the draw would), then once per write-mask bit, with only
  * that bit writable, that bit as the reference, and depth writes off.
  */
+// <barrierregion> a draw writes at most its scissor (the pass extent when none is set): note it
+static inline void nvmtl_dirty_note(nvk_cmdbuf *c) {
+    if (c->dr_state == 2) return;
+    if (!c->rp_w || !c->rp_h) { c->dr_state = 2; return; }
+    int32_t x0 = 0, y0 = 0, x1 = (int32_t)c->rp_w, y1 = (int32_t)c->rp_h;
+    if (c->has_sc) {
+        const int64_t sx1 = (int64_t)c->sc_x + c->sc_w, sy1 = (int64_t)c->sc_y + c->sc_h;
+        if (c->sc_x > x0) x0 = c->sc_x; if (c->sc_y > y0) y0 = c->sc_y;
+        if (sx1 < x1) x1 = (int32_t)sx1; if (sy1 < y1) y1 = (int32_t)sy1;
+    }
+    if (x1 <= x0 || y1 <= y0) return;   // an empty scissor draws nothing
+    if (c->dr_state == 0) { c->dr_x0 = x0; c->dr_y0 = y0; c->dr_x1 = x1; c->dr_y1 = y1; c->dr_state = 1; return; }
+    if (x0 < c->dr_x0) c->dr_x0 = x0; if (y0 < c->dr_y0) c->dr_y0 = y0;
+    if (x1 > c->dr_x1) c->dr_x1 = x1; if (y1 > c->dr_y1) c->dr_y1 = y1;
+}
+int nvmtl_vk_snapshot_dirty(nvk_cmdbuf *c, int32_t *x, int32_t *y, uint32_t *w, uint32_t *h) {
+    const unsigned s = c->dr_state; c->dr_state = 0;
+    if (s == 1) { *x = c->dr_x0; *y = c->dr_y0; *w = (uint32_t)(c->dr_x1 - c->dr_x0); *h = (uint32_t)(c->dr_y1 - c->dr_y0); }
+    return (int)s;
+}
+// the switch file is looked at once a second
+int nvmtl_region_on(void) {
+    static _Atomic uint64_t chk; static _Atomic int on = 1;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW), last = atomic_load(&chk);
+    if (now - last > 1000000000ull && atomic_compare_exchange_strong(&chk, &(uint64_t){last}, now))
+        atomic_store(&on, access("/Library/GPUBundles/nobarrierregion", F_OK) != 0);
+    return atomic_load(&on);
+}
