+// <xegfx>
+// 2026-11-05 22:49: WindowServer crashed in the memcpy below: it had unmapped the pages behind a no-copy buffer that was
+// still alive (135168 bytes, "not in any region"). The same unmapping lost the device on 11-04 and 11-05 (see
+// xemesa/hostptr-mesa.patch). A real driver has its own hold on those pages; here a copied buffer only has the address.
+// So look before each copy. Once the pages are gone the buffer keeps its last bytes for good, because the address may
+// come back as someone else's memory. A copy-back also skips pages it may not write: read-only no-copy buffers are
+// exactly the ones that get copied. The check is one system call per region, far less than the copy it guards.
+static int nvmtl_host_range_ok(const void *ptr, size_t size, vm_prot_t need)
+{
+    mach_vm_address_t a = (mach_vm_address_t)(uintptr_t)ptr; const mach_vm_address_t end = a + size;
