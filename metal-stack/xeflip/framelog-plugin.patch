@@ -302,6 +302,23 @@
         for (uint64_t m = atomic_load(&gMax); g > m && !atomic_compare_exchange_weak(&gMax, &m, g); ) ;
         for (uint64_t m = atomic_load(&dMax); dn > m && !atomic_compare_exchange_weak(&dMax, &m, dn); ) ;
     } else atomic_fetch_add(&untimed, 1);
+    // <framelog> every composite on its own line while /Library/GPUBundles/framelog-on exists (checked once a second):
+    // total, commit->GPU, GPU, end->done in us, parts, and what the main thread did since the previous composite: surface
+    // textures asked for (count, us), host imports (count, us), texture-barrier snapshot refreshes, textures really made.
+    {
+        extern uint64_t nvmtl_fl[8]; void nvlog_raw(const char *fmt, ...);
+        static _Atomic uint64_t chk; static _Atomic int on;
+        const uint64_t last_chk = atomic_load(&chk);
+        if (now - last_chk > 1000000000ull && atomic_compare_exchange_strong(&chk, &(uint64_t){last_chk}, now))
+            atomic_store(&on, access("/Library/GPUBundles/framelog-on", F_OK) == 0);
+        if (atomic_load(&on)) {
+            uint64_t f[6]; for (int i = 0; i < 6; i++) f[i] = __atomic_exchange_n(&nvmtl_fl[i], 0, __ATOMIC_RELAXED);
+            nvlog_raw("WSFRAME t=%llu total=%llu q=%llu g=%llu dn=%llu parts=%lu tex=%llu/%lluus imp=%llu/%lluus bar=%llu made=%llu",
